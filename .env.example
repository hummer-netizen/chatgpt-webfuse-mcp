# ChatGPT + Webfuse MCP Configuration
# Note: These values go into the ChatGPT MCP connector config, not a .env file.
# This file documents what's needed.

# Webfuse Space REST API key (rk_...) - used in the MCP connector Authorization header
WEBFUSE_REST_KEY=rk_...

# MCP endpoint URL (fixed, same for all users)
MCP_ENDPOINT=https://session-mcp.webfu.se/mcp
